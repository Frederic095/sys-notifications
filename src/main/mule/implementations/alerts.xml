<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:email="http://www.mulesoft.org/schema/mule/email" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd">
	<sub-flow name="impl-post-alerts" doc:id="3460ddd1-9257-44b3-a43d-c42a262756f9" >
		<logger level="DEBUG" doc:name="Input Email Step" doc:id="ad8227a1-27df-44a6-a2ea-f5e11e01cc88" message='#[%dw 2.0&#10;output application/json indent=false&#10;&#10;---&#10;{&#10;    step: "Input Mail Step",&#10;    data: {&#10;        business: {emails : " Nombre de email à faire : $(sizeOf(payload))"},&#10;        technical: {}&#10;    }&#10;}]' category="${app.name}" />
		<foreach doc:name="For Each" doc:id="b045bffb-b362-4d22-adaa-7addbd58205f" collection="#[payload]">
			<set-variable value="#[output json&#10;&#10;---&#10;&#10;payload.user.email]" doc:name="{email}" doc:id="3af1f254-adec-451d-a6fd-8feb221082ad" variableName="email" />
			<set-variable value='#[output json&#10;&#10;---&#10;&#10;"$(payload.user.firstname) $(payload.user.lastname)"]' doc:name="[fullName]" doc:id="0603b597-4258-48ca-90d7-255d10f2298a" variableName="fullName" />
			<parse-template doc:name="Mail HTML content [mail]" doc:id="36c3177a-578f-435c-a484-02de15902806" location="ClimbsmartNewsletter.html" target="mail"/>
			<http:request doc:name="Send Mail Request" doc:id="7475f7f1-79b9-4008-8cdf-45bc3d90d80e" method="POST" url="https://api.sendgrid.com/v3/mail/send" >
				<http:body ><![CDATA[#[output application/json
//var htmlContent = read("ClimbsmartNewsletter.html", "text/plain")
---
{
  "personalizations":[
    {
      "to":[
        {
          "email": vars.email,
          "name": vars.fullName
        }
      ],
      "subject":"Suggestions de grimpe cette semaine !"
    }
  ],
  "content":[
    {
      "type":"text/html",
      "value": vars.mail
    }
  ],
  "from":{
    "email":"nguyenfrederic000@gmail.com",
    "name":"ClimbingSmart Newsletter"
  }
}]]]></http:body>
				<http:headers ><![CDATA[#[%dw 2.0
output application/json
---
{
    Authorization: "Bearer " ++ p('sendgrid.api_key'),
    "Content-Type": "application/json"
}]]]></http:headers>
			</http:request>
			<logger level="DEBUG" doc:name="Debug after mail body mapping" doc:id="e29e733a-a909-4135-ba48-612b19bf2b86" message='#[output json indent=false&#10;---&#10;{&#10;	step: "Debug after mail body mapping",&#10;	data: {&#10;		business: {},&#10;		technical: {&#10;			emailContent: vars.mail&#10;		}&#10;	}&#10;}]' category="${app.name}" />
			<!-- [STUDIO:"to user"]<email:send doc:name="to user" doc:id="528bc1e6-0dc4-45cd-8925-131973aad327" config-ref="Email_SMTP" fromAddress="${sendgrid.fromAddress}" subject='Suggestions de grimpe cette semaine !'>
				<email:to-addresses >
					<email:to-address value="#[vars.email&#93;" />
				</email:to-addresses>
				<email:body contentType="text/html">
					<email:content ><![CDATA[#[vars.mail&#93;&#93;&#93;></email:content>
				</email:body>
			</email:send> [STUDIO] -->
			<logger level="DEBUG" doc:name="After sending Email" doc:id="9e84e7fe-2720-41e0-b988-98039ddad0cb" message='#[%dw 2.0&#10;output json indent=false&#10;&#10;---&#10;{&#10; step: "After email Sent",&#10; data: {&#10;  business: {&#10;  	email: vars.email,&#10;  	fullName : vars.fullName&#10;  },&#10;  technical: {}&#10; }&#10;}]' category="${app.name}" />
		</foreach>
		<!-- [STUDIO:"HTML response"]<set-payload value="#[vars.mail&#93;" doc:name="HTML response" doc:id="5cdbb598-efae-47dc-83ad-38c062923819" mimeType="text/html" /> [STUDIO] -->
		<set-variable value="Notifications sent successfully." doc:name="[customMessage]" doc:id="6f89d84a-54a8-4c96-b19c-23c3dd9c0108" variableName="customMessage" />
		<logger level="DEBUG" doc:name="End Flow" doc:id="f398f04a-59b7-4435-b42c-e004c743c8e8" message='#[%dw 2.0&#10;output json&#10;&#10;---&#10;{&#10; step: "post email endFlow",&#10; data: {&#10;  business: {},&#10;  technical: { &#10;  	email : sizeOf(payload)&#10;  }&#10; }&#10;}]' category="${app.name}" />
	</sub-flow>
</mule>
