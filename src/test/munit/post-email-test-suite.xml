<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="post-email-test-suite.xml" />
	<munit:test name="post-email-test-suiteTest" doc:id="a3d29102-67d7-48d6-9633-d26f51815b00" >
		<munit:behavior >
			<munit-tools:spy doc:name="Transform Message" doc:id="00ec580c-5bac-4b7e-95ff-b4d5c777a33e" processor="ee:transform">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Transform Message" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="03630ec2-f84e-4749-89ba-1c663494e035" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:after-call >
					<set-variable value="#[vars.counter]" doc:name="[counter]" doc:id="f2ffb7e9-2b44-4730-a50b-b52853d0ad88" variableName="counter"/>
					<choice doc:name="Choice" doc:id="e99ebce9-414f-4b28-8df0-3dc3be1e9507" >
						<when expression="#[vars.counter ==1]">
							<munit-tools:assert-equals doc:name="Assert equals" doc:id="488ee2d3-b97c-469b-90a3-b6cb5afa41ea" actual="#[payload]" expected='#[readUrl("classpath://data/EmailForm.html","text/plain")]'/>
						</when>
					</choice>
				</munit-tools:after-call>
			</munit-tools:spy>
			<munit-tools:mock-when doc:name="Request" doc:id="f6793753-e611-4d91-819f-a2d9390b36c8" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Request" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="b1b8065a-7fe3-43ac-9bdf-2bb0c1b63c5e" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value='#[readUrl("classpath://data/EmailForm.html","text/plain")]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<set-payload value='#[readUrl("classpath://data/PostEmailData.json","application/json")]' doc:name="PostEmailData" doc:id="04a8ffe2-9cc3-4cd1-9953-e8bc06f1011c" />
			<flow-ref doc:name="to impl-post-email" doc:id="e7a32ea4-a751-46cf-aa5d-83727d43c28b" name="impl-post-email"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:verify-call doc:name="Verify call" doc:id="153d609e-a44f-4dfc-b0cb-ca56df760391" processor="logger" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="DEBUG" attributeName="level" />
					<munit-tools:with-attribute whereValue="End Flow" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="18994358-328d-4faa-a067-0ca6fb77b4ec" attributeName="doc:id" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


</mule>
